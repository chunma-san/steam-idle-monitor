# Private local configuration. Never commit a populated copy.
GARDEN_REMOTE=git@github.com:YOUR_ACCOUNT/YOUR_REPOSITORY.git
GARDEN_AUTHOR_NAME=YOUR_GITHUB_LOGIN
GARDEN_AUTHOR_EMAIL=YOUR_GITHUB_NOREPLY_EMAIL
GARDEN_REPO_DIR=/var/lib/activity-garden/repository
GARDEN_TIMEZONE=Europe/Paris
# Set GIT_SSH_COMMAND in the systemd environment file to use a repository-specific key.
